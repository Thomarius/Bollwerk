{
  "name": "@bollwerk/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The desktop app for releases: the server behind a minimal window (PLAN 11.17)",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.js",
    "start": "node build.js && electron .",
    "package": "node build.js && node package.js"
  },
  "devDependencies": {
    "@bollwerk/config": "*",
    "@bollwerk/server": "*",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.thomarius.bollwerk",
    "productName": "Bollwerk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../config",
        "to": "config",
        "filter": [
          "*.json"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "bollwerk",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux.${ext}"
    }
  },
  "author": "Thomas Arnold",
  "desktopName": "bollwerk.desktop"
}
