{
  "name": "bollwerk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multiplayer castle siege game, an unofficial fan game inspired by Rampart (Atari Games, 1990)",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "start": "npm run build && npm start -w @bollwerk/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build -w @bollwerk/client && npm run build -w @bollwerk/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "soak": "tsx tools/headless/src/soak.ts",
    "credits": "tsx packages/config/src/writeCredits.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.5.1": true
  }
}
